<?xml version="1.0" encoding="utf-8"?>
<network-security-config>
    <!--
        Default stays deny (matches the platform default for targetSdk 34).
        Only the room host gets a cleartext exception, because the page is
        currently served over plain http. Scope it tight; widen nothing else.
    -->
    <base-config cleartextTrafficPermitted="false" />
    <domain-config cleartextTrafficPermitted="true">
        <domain includeSubdomains="false">8.209.196.82</domain>
    </domain-config>
</network-security-config>
